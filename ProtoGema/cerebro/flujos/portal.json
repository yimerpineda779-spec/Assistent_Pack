      "name": "Petición del panel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "webhookId": "ee948dc7-a3e5-58eb-bf1e-a43d1c53020d"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "573d9477-d05f-5a69-8494-2df0bbe9cd3e",
              "leftValue": "={{ ($json.body || {}).ruta }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "probar-clave"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "22ec8416-c4b6-59af-b407-cbe08c063e50",
      "name": "¿Probar clave?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://generativelanguage.googleapis.com/v1beta/models?pageSize=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ String((($json.body || {}).datos || {}).clave || '').trim() }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "ad8d6cbc-e779-51bc-80e1-b183b7d127f7",
      "name": "Consultar a Google",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $json.statusCode === 200, error: $json.statusCode === 200 ? null : ($json.statusCode === 0 ? 'Sin conexión a internet.' : 'Google rechazó la clave.') } }}",
        "options": {}
      },
      "id": "5d7e2a15-e371-5b7c-af10-f499953186ec",
      "name": "Resultado de la clave",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT gema.api($1::jsonb) AS r;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ ruta: String(($json.body || {}).ruta || ''), token: $json.headers['x-gema-token'] || '', datos: ($json.body || {}).datos || {} }) }}"
        }
      },
      "id": "7cc4f1d7-9696-5446-8882-97e23125e331",
      "name": "Resolver en la base",
