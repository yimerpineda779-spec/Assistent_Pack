# Este archivo es solo un ejemplo. El lanzador crea el archivo .env real
# la primera vez que abres Cortana (no hace falta editarlo a mano).

# Clave gratuita de Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clave gratuita de Tavily para buscar en internet (opcional): https://app.tavily.com
TAVILY_API_KEY=

# Modelo de Gemini que usará Cortana
GEMINI_MODEL=gemini-3-flash-preview

# Clave interna para cifrar los datos de n8n (se genera sola, no la cambies)
N8N_ENCRYPTION_KEY=

ZONA_HORARIA=America/Caracas
PUERTO_CORTANA=8765

# Panel de n8n para el desarrollador (5679 para no chocar con otro n8n en 5678)
PUERTO_N8N=5679

# Contraseña de la base de datos de la agenda (se genera sola, no la cambies)
DB_PASSWORD=
