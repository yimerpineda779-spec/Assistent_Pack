# =============================================================
#  Protección general del repositorio (Cortana, AssistentD y ProtoGema)
#  Nada de esto debe subirse a un repositorio público.
# =============================================================

# Claves y configuración local (los lanzadores crean estos archivos solos)
.env
.env.*
!.env.example
*.pem
*.key

# Registros de ejecución
logs/
registro/
registros/
*.log

# Datos de n8n y bases de datos locales
n8n_data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
crash.journal

# Respaldos de la base de datos
respaldo*.sql
*.dump

# Dependencias y archivos temporales
node_modules/
__pycache__/
*.pyc

# Archivos del sistema y de editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
~$*
